# ============================================================
# Aniboxd Backend - Environment Variables
# ============================================================
# ATENÇÃO: Não versione este arquivo com credenciais reais.
# Copie para .env e preencha os valores.

# --- Banco de Dados PostgreSQL ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/DATABASE
DATABASE_URL="postgresql://aniboxd_user:250922@localhost:5432/aniboxd_db"

# --- JWT ---
JWT_SECRET="904756973986379673765789368765873683673869837689736554856465467436364"
JWT_EXPIRES_IN="15m"

# --- Refresh Token ---
REFRESH_TOKEN_SECRET="0625365025462"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --- Redis ---
REDIS_URL="redis://:250922@localhost:6379"

# --- RabbitMQ ---
RABBITMQ_URL="amqp://aniboxd_mq_user:250922@localhost:5672"

# --- App ---
PORT=3000
NODE_ENV=development
