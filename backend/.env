# ============================================================
# Aniboxd Backend - Environment Variables
# ============================================================
# ATENÇÃO: Não versione este arquivo com credenciais reais.
# Copie para .env e preencha os valores.

# --- Banco de Dados PostgreSQL ---
    # Formato: postgresql://USUARIO:SENHA@HOST:PORTA/DATABASE
    DATABASE_URL="postgresql://aniboxd_user:aniboxd_secure_password@localhost:5432/aniboxd_db"

# --- JWT ---
JWT_SECRET="troque-por-uma-chave-secreta-muito-longa-e-aleatoria"
JWT_EXPIRES_IN="15m"

# --- Refresh Token ---
REFRESH_TOKEN_SECRET="outra-chave-secreta-para-refresh-token"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --- Redis ---
REDIS_URL="redis://:aniboxd_redis_secure_password@localhost:6379"

# --- RabbitMQ ---
RABBITMQ_URL="amqp://aniboxd_mq_user:aniboxd_mq_secure_password@localhost:5672"

# --- App ---
PORT=3000
NODE_ENV=development
