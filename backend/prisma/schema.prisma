datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum MediaType {
  ANIME
  MANGA
  MANHWA
  MANHUA
  LIGHT_NOVEL
  WEBTOON
}

enum MediaStatus {
  AIRING
  FINISHED
  UPCOMING
  HIATUS
  CANCELLED
}

enum ReadingWatchingStatus {
  PLANNING
  CURRENT     // Watching or Reading
  COMPLETED
  DROPPED
  PAUSED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  role         UserRole      @default(USER)
  isBanned     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  profile      Profile?
  sessions     Session[]
  followers    Follow[]      @relation("Following")
  following    Follow[]      @relation("Follower")
  reviews      Review[]
  likes        ReviewLike[]
  comments     ReviewComment[]
  lists        List[]
  activities   Activity[]
  notifications Notification[]
  history      AcquisitionHistory[]
  auditLogs    AuditLog[]
  tagVotes     MediaTagVote[]

  @@index([username])
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  bio            String?  @db.VarChar(500)
  avatarUrl      String?
  bannerUrl      String?
  animeTimeMinutes Int    @default(0)
  mangaChaptersRead Int   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Media {
  id            String        @id @default(uuid())
  externalId    String?       @unique // ID do AniList / MyAnimeList
  title         String
  type          MediaType
  coverUrl      String?
  bannerUrl     String?
  synopsis      String?       @db.Text
  author        String?
  studio        String?
  genres        String[]      // Ex: ["Action", "Fantasy"]
  releaseYear   Int?
  status        MediaStatus   @default(UPCOMING)
  totalEpisodes Int?          @default(0)
  totalChapters Int?          @default(0)
  averageRating Float         @default(0.0)
  ratingCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reviews       Review[]
  listMedia     ListMedia[]
  history       AcquisitionHistory[]
  tagVotes      MediaTagVote[]

  @@index([title])
  @@index([type, status])
}

model Review {
  id           String          @id @default(uuid())
  userId       String
  mediaId      String
  rating       Float           // Avaliação de 1 a 5 (ex: 4.5)
  content      String          @db.Text
  isSpoiler    Boolean         @default(false)
  likeCount    Int             @default(0)
  commentCount Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  media        Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  likes        ReviewLike[]
  comments     ReviewComment[]
  versions     ReviewVersion[]

  @@index([mediaId, rating])
  @@index([userId, mediaId])
  @@index([createdAt(sort: Desc)])
}

model ReviewLike {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId])
}

model ReviewComment {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  content   String   @db.VarChar(1000)
  isSpoiler Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewVersion {
  id        String   @id @default(uuid())
  reviewId  String
  rating    Float
  content   String   @db.Text
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt(sort: Desc)])
}

model List {
  id          String      @id @default(uuid())
  userId      String
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(500)
  isPublic    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItems  ListMedia[]

  @@index([userId, isPublic])
}

model ListMedia {
  listId    String
  mediaId   String
  createdAt DateTime @default(now())

  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([listId, mediaId])
}

model AcquisitionHistory {
  id          String                @id @default(uuid())
  userId      String
  mediaId     String
  status      ReadingWatchingStatus @default(PLANNING)
  progress    Int                   @default(0) // Episódios assistidos ou capítulos lidos
  startDate   DateTime?
  endDate     DateTime?
  score       Float?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       Media                 @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, mediaId])
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  type      String   // REVIEW_CREATED, LIST_CREATED, MEDIA_FAVORITED, FOLLOWED_USER
  payload   Json     // Dados específicos da atividade (ex: { reviewId, mediaTitle })
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // FOLLOW, LIKE, COMMENT, SYSTEM
  message   String
  read      Boolean  @default(false)
  payload   Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  // Pode ser nulo se for ação anônima/falha login
  action     String   // PROFILE_UPDATE, ACCOUNT_DELETION, ADMIN_BAN, SECURITY_BREACH
  ipAddress  String?
  userAgent  String?
  payload    Json?    // Estado anterior/novo
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}

model Tag {
  id          String         @id @default(uuid())
  name        String         @unique
  isNsfw      Boolean        @default(false)
  isSensitive Boolean        @default(false)
  mediaVotes  MediaTagVote[]
}

model MediaTagVote {
  mediaId   String
  tagId     String
  userId    String
  vote      Int      @default(1) // +1 ou -1

  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId, userId])
}
